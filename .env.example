# ============================================================
# Nexora — Application Settings (.env.example)
# ============================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# The install.sh script generates .env automatically.
# Edit .env directly to change settings after installation.
# ============================================================

# ------------------------------------------------------------
# Core / Phoenix
# ------------------------------------------------------------

# Secret key used by Phoenix to sign cookies and sessions.
# Generate with: openssl rand -base64 64 | tr -d '\n'
# REQUIRED — the application will not start without it.
SECRET_KEY_BASE=

# Hostname that Phoenix uses in generated URLs.
# Set to your domain name or IP address in production.
PHX_HOST=localhost

# Port exposed on the host machine.
# The container always listens on 4000 internally.
NEXORA_PORT=4000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Log level: debug | info | warning | error
# Default: info
LOG_LEVEL=info

# ------------------------------------------------------------
# Runtime / Agents
# ------------------------------------------------------------

# Maximum number of concurrent agent processes.
# Default: 10
MAX_AGENTS=10

# Agent heartbeat interval in seconds.
# Default: 30
HEARTBEAT_INTERVAL_SEC=30

# ------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------

# LLM provider to use: openai | ollama | local
# "ollama" is recommended — it runs as a companion container automatically.
LLM_PROVIDER=ollama

# API key for cloud LLM providers (OpenAI, etc.).
# Leave empty when using local/ollama provider.
LLM_API_KEY=

# Base URL for the LLM API.
# When using docker-compose the Ollama container is reachable at:
#   http://ollama:11434  (set automatically by docker-compose)
# Override only if you run Ollama on a different host.
LLM_BASE_URL=

# Model name to use (e.g., llama3, mistral, codellama, gemma2).
# After first start, pull a model:  docker exec nexora-ollama ollama pull llama3
LLM_MODEL=llama3

# ------------------------------------------------------------
# Ollama
# ------------------------------------------------------------

# Port on the host to expose the Ollama API (default: 11434).
OLLAMA_PORT=11434

# ------------------------------------------------------------
# Workspace / File Access
# ------------------------------------------------------------

# Directory on the host machine mounted into the container at /workspace.
# Agents can read and write files here.
# Default: ./workspace (relative to the project root).
WORKSPACE_DIR=./workspace

# ------------------------------------------------------------
# Billing / Budget
# ------------------------------------------------------------

# Monthly budget limit (in USD). 0 = unlimited.
# The budget enforcer will warn when usage approaches this limit.
BUDGET_LIMIT_USD=0

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Enable or disable authentication for the web interface.
# Set to "true" to require login.
AUTH_ENABLED=false

# Admin username and password (used when AUTH_ENABLED=true).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Comma-separated list of allowed IP addresses.
# Leave empty to allow all.
ALLOWED_IPS=

# ------------------------------------------------------------
# Sandbox / Code Generation
# ------------------------------------------------------------

# Maximum number of generate-build-test-fix iterations per task.
# Default: 5
MAX_FIX_ITERATIONS=5

# ------------------------------------------------------------
# GitHub / Git Publishing
# ------------------------------------------------------------

# GitHub personal access token for pushing generated projects.
# Create one at: https://github.com/settings/tokens
# Leave empty if you don't need auto-publishing.
GITHUB_TOKEN=

# Git author identity used for commits made by the agent.
GIT_AUTHOR_NAME=Nexora Agent
GIT_AUTHOR_EMAIL=agent@nexora.local
