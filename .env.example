# ============================================================
# Nexora — Application Settings (.env.example)
# ============================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# The install.sh script generates .env automatically.
# Edit .env directly to change settings after installation.
# ============================================================

# ------------------------------------------------------------
# Core / Phoenix
# ------------------------------------------------------------

# Secret key used by Phoenix to sign cookies and sessions.
# Generate with: openssl rand -base64 64 | tr -d '\n'
# REQUIRED — the application will not start without it.
SECRET_KEY_BASE=

# Hostname that Phoenix uses in generated URLs.
# Set to your domain name or IP address in production.
PHX_HOST=localhost

# Port exposed on the host machine.
# The container always listens on 4000 internally.
NEXORA_PORT=4000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Log level: debug | info | warning | error
# Default: info
LOG_LEVEL=info

# ------------------------------------------------------------
# Runtime / Agents
# ------------------------------------------------------------

# Maximum number of concurrent agent processes.
# Default: 10
MAX_AGENTS=10

# Agent heartbeat interval in seconds.
# Default: 30
HEARTBEAT_INTERVAL_SEC=30

# ------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------

# LLM provider to use: openai | ollama | local
# "local" and "ollama" work fully offline without cloud APIs.
LLM_PROVIDER=local

# API key for cloud LLM providers (OpenAI, etc.).
# Leave empty when using local/ollama provider.
LLM_API_KEY=

# Base URL for the LLM API (useful for Ollama or custom endpoints).
# Example for Ollama: http://localhost:11434
LLM_BASE_URL=

# Model name to use (e.g., gpt-4, llama3, mistral).
LLM_MODEL=

# ------------------------------------------------------------
# Billing / Budget
# ------------------------------------------------------------

# Monthly budget limit (in USD). 0 = unlimited.
# The budget enforcer will warn when usage approaches this limit.
BUDGET_LIMIT_USD=0

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Enable or disable authentication for the web interface.
# Set to "true" to require login.
AUTH_ENABLED=false

# Admin username and password (used when AUTH_ENABLED=true).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Comma-separated list of allowed IP addresses.
# Leave empty to allow all.
ALLOWED_IPS=
